GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-your-preferred-groq-model
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mediassist_documents
# Optional notebook-style local Qdrant storage. Leave blank to use the OS temp directory.
QDRANT_PATH=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DATABASE_PATH=mediassist_db/db/mediassist.db
FRONTEND_ORIGIN=http://localhost:3000

# --- Evaluation & guardrail layer -------------------------------------------
# Separate, larger Groq model used by the OpenEvals guardrail judge, RAGAS and the
# LLM-as-a-judge. Must differ from GROQ_MODEL so the system never grades itself.
JUDGE_MODEL=openai/gpt-oss-120b
# Reasoning effort for the gpt-oss judge (low keeps a full run within Groq's free daily quota).
JUDGE_REASONING_EFFORT=low
GROQ_BASE_URL=https://api.groq.com/openai/v1
# true = rules + OpenEvals LLM judge on every request (fails closed if the judge errors).
# false = deterministic rules only (offline demos).
GUARDRAIL_LLM_ENABLED=true
# Structured JSONL logs (guardrail_events.jsonl, requests.jsonl), relative to backend/.
LOG_DIR=logs
# Heuristic eval: maximum acceptable end-to-end latency per request.
LATENCY_THRESHOLD_MS=20000

# --- LangSmith tracing ------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=medibot-guardrails
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
